# =============================================================================
# PG Manager virtual host
#
# This is a TEMPLATE. The nginx image's entrypoint runs envsubst over every
# /etc/nginx/templates/*.template and writes the result to /etc/nginx/conf.d/.
# Only variables present in the container environment are substituted, so
# ${DOMAIN_NAME} is replaced while nginx's own $host, $remote_addr, $request_id
# and friends are left exactly as written.
#
# FIRST BOOT: nginx will not start without a certificate at the paths below.
# Run scripts/init-letsencrypt.sh before the first `docker compose up` — it stages a
# self-signed placeholder, starts nginx, then swaps in the real Let's Encrypt cert.
# =============================================================================


# -----------------------------------------------------------------------------
# Default server — reject anything addressed to a hostname we do not serve.
#
# Without this, nginx answers on the first-declared server block for any Host
# header, so the site responds to bare-IP scans and to whatever hostnames someone
# points at this address. 444 is nginx's non-standard "close without a response":
# cheaper than a 403 and it gives a scanner nothing at all.
# -----------------------------------------------------------------------------
server {
    listen      80  default_server;
    listen      443 ssl default_server;
    http2       on;
    server_name _;

    # A certificate is mandatory on an ssl listener even when we only ever close the
    # connection; reuse the real one rather than generating a throwaway.
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;

    access_log off;
    return 444;
}


# -----------------------------------------------------------------------------
# Port 80 — ACME challenge, container healthcheck, and the HTTPS redirect
# -----------------------------------------------------------------------------
server {
    listen      80;
    listen      [::]:80;
    server_name ${DOMAIN_NAME};

    access_log /var/log/nginx/access.log main;
    error_log  /var/log/nginx/error.log warn;

    # Let's Encrypt HTTP-01 validation. MUST stay on plain HTTP and MUST come before
    # the redirect below — the ACME client follows redirects, but a redirect to a
    # host whose certificate is not yet valid is exactly the chicken-and-egg this
    # location exists to break.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        access_log off;
    }

    # Docker's healthcheck for this container. Served on :80 without a redirect so the
    # probe does not have to follow a 301 or present a certificate.
    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "healthy\n";
    }

    # Everything else goes to HTTPS. 301, not 302: permanent lets browsers and
    # Cloudflare cache the upgrade, and it is what HSTS preload expects.
    location / {
        return 301 https://$host$request_uri;
    }
}


# -----------------------------------------------------------------------------
# Port 443 — the application
# -----------------------------------------------------------------------------
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name ${DOMAIN_NAME};

    # --- Certificates --------------------------------------------------------
    # Managed by certbot; the renewal sidecar rewrites these files in place and
    # nginx picks them up on its 6-hourly reload.
    ssl_certificate           /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key       /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
    ssl_trusted_certificate   /etc/letsencrypt/live/${DOMAIN_NAME}/chain.pem;
    # TLS protocol/cipher policy is set once at http{} level in snippets/ssl.conf.

    # --- Security headers ----------------------------------------------------
    include /etc/nginx/snippets/security-headers.conf;

    # --- Logging -------------------------------------------------------------
    access_log /var/log/nginx/access.log main;
    error_log  /var/log/nginx/error.log warn;

    # --- Per-IP connection cap ------------------------------------------------
    # 50 is generous for a browser (6 per host) or the Flutter client, and low enough
    # to stop one address holding hundreds of sockets open.
    limit_conn conn_zone 50;

    # --- Body size -----------------------------------------------------------
    # Inherited 25m from http{}; the bulk-upload location below raises it.
    client_max_body_size 25m;

    # -------------------------------------------------------------------------
    # Health probe for external monitoring (UptimeRobot, Cloudflare, the deploy script).
    #
    # Proxies to the app's readiness group ONLY — a single fixed path on the actuator
    # port. The rest of that port stays unreachable from the internet, which matters
    # because the management context runs outside the app's Spring Security filter
    # chain: proxying /actuator/ wholesale would publish env, metrics and mappings
    # with no authentication whatsoever.
    #
    # show-details is `never` in application-prod.yml, so the response body is
    # {"status":"UP"} with no infrastructure detail leaked.
    # -------------------------------------------------------------------------
    location = /health {
        access_log off;

        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://pgmanager_actuator/actuator/health/readiness;

        # Fail fast: a monitoring probe must not sit on a 120s read timeout.
        proxy_connect_timeout 3s;
        proxy_read_timeout    5s;
    }

    # -------------------------------------------------------------------------
    # Authentication endpoints — the strictest rate limit on the server.
    #
    # Covers /api/auth/login, /refresh, /tenant/login, /password/forgot, /password/reset.
    # Each login attempt costs a BCrypt verification, which is deliberately expensive
    # (~100ms of CPU). Left unthrottled, a credential-stuffing run pins all available
    # cores and takes the whole API down as a side effect of the attack.
    #
    # 12r/m with burst=5 nodelay: a user fumbling their password five times in a row
    # is served instantly; the sixth waits; a script is throttled to one attempt per
    # five seconds.
    # -------------------------------------------------------------------------
    location ^~ /api/auth/ {
        limit_req  zone=auth_zone burst=5 nodelay;
        limit_conn conn_zone 20;

        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://pgmanager_api;
    }

    # -------------------------------------------------------------------------
    # Public tenant self check-in — unauthenticated AND it writes.
    #
    # /api/public/self-checkin/{orgId}/{propertyId}/{sig} is permitAll and creates
    # party/person rows on POST. The URL is signed so the ids cannot be swapped, but
    # anyone holding a valid QR link can submit repeatedly. 20r/m is far above a human
    # filling in a registration form and well below a script.
    # -------------------------------------------------------------------------
    location ^~ /api/public/ {
        limit_req  zone=pub_zone burst=10 nodelay;
        limit_conn conn_zone 10;

        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://pgmanager_api;
    }

    # -------------------------------------------------------------------------
    # Bulk CSV upload — long-running, large body, super-admin only.
    #
    # Declared before the general /api/ block because nginx matches the longest
    # prefix, and this one needs its own body limit and timeouts: a few thousand
    # tenant rows each run TenantService.create, and the whole thing is one request.
    # -------------------------------------------------------------------------
    location ^~ /api/super-admin/upload/ {
        limit_req zone=api_zone burst=10 nodelay;

        client_max_body_size 100m;
        client_body_timeout  300s;

        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://pgmanager_api;

        # A large import can genuinely exceed five minutes.
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;

        # Retrying a partially-applied import would duplicate tenants.
        proxy_next_upstream off;
    }

    # -------------------------------------------------------------------------
    # Report downloads — the response is a JSON payload the Flutter client renders
    # into a PDF, but the aggregate queries behind it are the slowest in the app.
    # -------------------------------------------------------------------------
    location ^~ /api/reports/ {
        limit_req zone=api_zone burst=20 nodelay;

        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://pgmanager_api;

        proxy_read_timeout 180s;
    }

    # -------------------------------------------------------------------------
    # Everything else under /api/ — normal authenticated traffic.
    #
    # `^~` is load-bearing, not decoration. A plain `location /api/` is an ordinary
    # prefix match, and nginx evaluates regex locations AFTER prefix matches and lets
    # a regex WIN. The static-asset regex further down matches `\.(js|css|json|…)$`,
    # so a request to an API path ending in one of those extensions would be handed
    # to the static file handler and answered with 404 instead of being proxied.
    # `^~` tells nginx to stop once this prefix matches and skip the regexes.
    # -------------------------------------------------------------------------
    location ^~ /api/ {
        limit_req zone=api_zone burst=60 nodelay;

        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://pgmanager_api;
    }

    # -------------------------------------------------------------------------
    # WebSocket / SSE upgrade path.
    #
    # This application does not currently expose one — it is here so that adding
    # real-time notifications later needs no nginx change and no outage.
    #
    # The Connection header is NOT set here: proxy-common.conf already sets it from
    # the $connection_upgrade map, which resolves to "upgrade" for a handshake and to
    # empty for anything else. Setting it again locally would leave two conflicting
    # proxy_set_header directives for one field, because nginx appends rather than
    # overwrites.
    #
    # Note the timeouts: a WebSocket is idle by nature and the 120s default would
    # tear down a healthy connection every two minutes.
    # -------------------------------------------------------------------------
    location ^~ /ws {
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_pass http://pgmanager_api;

        proxy_set_header Upgrade $http_upgrade;

        proxy_buffering    off;      # streaming: never hold frames back
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # -------------------------------------------------------------------------
    # API documentation — blocked.
    #
    # SWAGGER_ENABLED=false already switches this off in the application, so this is
    # the second of two locks: the spec enumerates every endpoint, role and DTO field
    # in the system and is a free reconnaissance map.
    #
    # To open it temporarily for an internal audit, replace the `return 403` with the
    # commented block and restrict by source address — never leave it world-readable.
    # -------------------------------------------------------------------------
    location ~ ^/(swagger-ui|swagger-ui\.html|v3/api-docs) {
        access_log off;
        return 403;

        # allow 203.0.113.10;      # your office egress IP
        # deny  all;
        # include /etc/nginx/snippets/proxy-common.conf;
        # proxy_pass http://pgmanager_api;
    }

    # Actuator is never reachable from outside; /health above is the only door in.
    location ^~ /actuator {
        access_log off;
        return 403;
    }

    # Block dotfiles (.env, .git/config, .htpasswd) that a scanner will probe for.
    location ~ /\. {
        access_log off;
        log_not_found off;
        deny all;
    }

    # -------------------------------------------------------------------------
    # Static assets — the Flutter web build, if you deploy one to nginx/www.
    #
    # Two cache policies, and the split matters:
    #   * fingerprinted assets (main.dart.js, *.wasm, fonts) carry a content hash in
    #     the filename, so they are immutable and cached for a year
    #   * index.html and flutter_service_worker.js must NOT be cached, or a deploy
    #     leaves browsers pinned to an old build that references asset filenames
    #     which no longer exist — a white screen that only a hard refresh fixes
    # -------------------------------------------------------------------------
    location ~* \.(?:js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|ico|webp|wasm|json|map)$ {
        root /var/www/html;
        access_log off;

        expires 1y;
        add_header Cache-Control "public, immutable" always;

        # Long-lived assets still need the security headers; `add_header` in a
        # location REPLACES all inherited ones rather than adding to them, so the
        # include has to be repeated here.
        include /etc/nginx/snippets/security-headers.conf;

        try_files $uri =404;
    }

    location / {
        root  /var/www/html;
        index index.html;

        # SPA fallback: deep links like /tenants/42 are client-side routes with no
        # file behind them, so serve the shell and let the router resolve it.
        try_files $uri $uri/ /index.html;

        add_header Cache-Control "no-store, must-revalidate" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # -------------------------------------------------------------------------
    # Error pages — JSON, not HTML.
    #
    # Every consumer of this host is an API client that parses JSON. Handing it
    # nginx's HTML error page produces an opaque parse failure in the app instead of
    # a readable message. `internal` keeps these unreachable as direct URLs.
    # -------------------------------------------------------------------------
    error_page 429 = @too_many;
    location @too_many {
        default_type application/json;
        return 429 '{"success":false,"message":"Too many requests. Please slow down and retry.","data":null}';
    }

    error_page 502 503 504 = @upstream_down;
    location @upstream_down {
        default_type application/json;
        return 503 '{"success":false,"message":"Service temporarily unavailable. Please retry shortly.","data":null}';
    }
}
