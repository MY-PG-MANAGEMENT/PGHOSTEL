# =============================================================================
# MySQL 8.4 LTS — production configuration for PG Manager
#
# Mounted read-only at /etc/mysql/conf.d/my.cnf and loaded via --defaults-file.
#
# Sized for a container limited to 6 GB (see docker-compose.yml). If you change that
# limit, change innodb_buffer_pool_size with it — the two must be adjusted together
# or MySQL will happily allocate past its cgroup limit and be OOM-killed.
#
# Written for 8.4. Options removed in 8.0/8.4 that you will find in older guides and
# that will PREVENT THE SERVER FROM STARTING if pasted in:
#   query_cache_size / query_cache_type   removed in 8.0
#   default_authentication_plugin         removed in 8.4 (use authentication_policy)
#   expire_logs_days                      removed in 8.0 (use binlog_expire_logs_seconds)
#   innodb_file_format, innodb_large_prefix, skip-host-cache   removed in 8.0
# =============================================================================

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

[mysqld]

# -----------------------------------------------------------------------------
# Character set and collation
#
# utf8mb4 is not optional here: tenant names, property names and complaint text are
# free-form Indian-language and emoji-capable input. MySQL's legacy `utf8` is a
# 3-byte subset that cannot store an emoji or several Devanagari sequences and
# truncates the row at the first 4-byte character.
#
# utf8mb4_0900_ai_ci is the 8.0+ default: Unicode 9.0 aware, accent- and
# case-insensitive, and materially faster than utf8mb4_general_ci.
# -----------------------------------------------------------------------------
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci

# Force the server's character set even if a client negotiates something else.
# Connector/J sends its own SET NAMES; this stops a stray legacy client writing
# latin1 into a utf8mb4 column.
skip-character-set-client-handshake

# -----------------------------------------------------------------------------
# Timezone
#
# A numeric offset, NOT 'Asia/Kolkata'. Named zones require the timezone tables to
# have been loaded into the `mysql` schema (mysql_tzinfo_to_sql), which the official
# Docker image does not do — a named zone here makes the server refuse to start.
#
# +05:30 must match TZ in .env. The app's schedulers are wall-clock based (invoices
# at 01:00, bed transfers at 00:05, rent reminders at 09:00); a mismatch between the
# JVM's zone and the database's shifts every generated due date by the difference.
# -----------------------------------------------------------------------------
default-time-zone = '+05:30'

# -----------------------------------------------------------------------------
# Networking and connections
# -----------------------------------------------------------------------------
bind-address    = 0.0.0.0        # container-internal only; not published to the host
port            = 3306

# X Protocol (port 33060) serves the document store. Nothing here uses it; disabling
# removes a listener and its memory.
mysqlx = 0

# Ceiling on concurrent connections. Budget: 30 per API replica (DB_POOL_MAX), plus
# the healthcheck, plus mysqldump during a backup, plus your own admin sessions.
# 300 leaves a very large margin — the constraint that matters is the pool size, not
# this number, because each connection costs ~256 KB of per-thread buffers.
max_connections     = 300
max_connect_errors  = 100000     # do not lock out a host after transient network errors

# DNS reverse lookups on connect are slow and unnecessary inside a Docker network.
# (The 8.0 replacement for the removed skip-host-cache.)
host_cache_size = 0
skip-name-resolve

# Must EXCEED HikariCP's max-lifetime (540s in application-prod.yml). Getting this
# backwards is the classic cause of intermittent
# "communications link failure" — the server closes an idle pooled connection that
# Hikari still believes is good, and the next query using it fails.
wait_timeout        = 600
interactive_timeout = 600

# Large enough for the biggest single statement: bulk CSV imports batch inserts, and
# api_request_log rows carry up to ~32 KB of masked payload.
max_allowed_packet = 64M

thread_cache_size = 64           # reuse threads instead of spawning per connection
back_log          = 512          # pending-connection queue during a burst

# -----------------------------------------------------------------------------
# InnoDB — the memory settings that actually matter
# -----------------------------------------------------------------------------

# The single most important number in this file. Every page of table and index data
# is served from here; anything not resident is a disk read. 3G of a 6G container
# limit leaves room for per-connection buffers, the redo log, and the OS page cache.
#
# Rule of thumb: 50-60% of the CONTAINER limit (not the host's RAM) for a container,
# vs the usual 70-80% guidance for a dedicated bare-metal server.
innodb_buffer_pool_size = 3G

# Split the pool so concurrent threads do not contend on one mutex. One instance per
# GB is the standard recommendation; each must be at least 1 GB to be worthwhile.
innodb_buffer_pool_instances = 3

# Load the pool contents back after a restart instead of running cold. Without this,
# the first several minutes after every deploy are slow while the pool refills.
innodb_buffer_pool_dump_at_shutdown = 1
innodb_buffer_pool_load_at_startup  = 1

# Redo log capacity (8.0.30+ replacement for innodb_log_file_size). Larger means
# fewer, larger checkpoint flushes — better write throughput at the cost of a longer
# crash recovery. 512M is a sane middle for this write volume.
innodb_redo_log_capacity = 512M

# --- Durability -------------------------------------------------------------
# 1 = flush and fsync the redo log at every commit. This is the ACID-compliant
# setting and the only defensible one for an application that records rent payments:
# a value of 2 can lose up to a second of committed transactions on host power loss.
# It costs write throughput. Pay it.
innodb_flush_log_at_trx_commit = 1

# Bypass the OS page cache for data files — with a 3G buffer pool, double-buffering
# the same pages in the kernel is wasted memory.
innodb_flush_method = O_DIRECT

# One tablespace file per table: allows reclaiming disk after a DROP, and makes
# per-table backup/restore possible.
innodb_file_per_table = 1

# --- I/O capacity -----------------------------------------------------------
# Tuned for the block volume on an Oracle Cloud Always Free instance, which is
# network-attached and not an NVMe SSD. Setting these to SSD-class values (2000+)
# on network storage makes InnoDB flush too aggressively and increases latency.
innodb_io_capacity     = 1000
innodb_io_capacity_max = 2000

innodb_read_io_threads  = 4
innodb_write_io_threads = 4
innodb_thread_concurrency = 0    # 0 = let InnoDB decide; it is better at this than we are

# Fail a blocked statement in 30s instead of the default 50s, so a lock pile-up
# surfaces as an application error rather than exhausting the connection pool.
innodb_lock_wait_timeout = 30

# Write every deadlock to the error log. Deadlocks in a multi-tenant app are usually
# a real ordering bug; without this you only ever see the client-side exception.
innodb_print_all_deadlocks = 1

# Do not re-sample index statistics on every metadata query — it makes
# INFORMATION_SCHEMA queries (and some ORM startup paths) needlessly slow.
innodb_stats_on_metadata = 0
innodb_stats_persistent  = 1

# Isolation level: left at the MySQL default, REPEATABLE-READ.
#
# READ-COMMITTED would reduce gap locking and is often recommended for Spring apps,
# but this application was developed and tested against the default. Switching it in
# production changes the visibility semantics of every existing transaction — most
# relevantly the invoice-generation idempotency check, which counts rows by
# (billing_account_id, invoice_month). Change it deliberately, with tests, or not at all.
# transaction_isolation = READ-COMMITTED

# -----------------------------------------------------------------------------
# Temporary tables
#
# Both must be set to the same value; MySQL uses the lower of the two. Aggregations
# that exceed it spill to an on-disk temp table, which is orders of magnitude slower.
# The reporting and dashboard queries here GROUP BY over a month of invoices, so 64M
# keeps them in memory. If SHOW GLOBAL STATUS LIKE 'Created_tmp_disk_tables' climbs
# steadily, raise both.
# -----------------------------------------------------------------------------
tmp_table_size      = 64M
max_heap_table_size = 64M

# -----------------------------------------------------------------------------
# Per-connection buffers
#
# These are allocated PER CONNECTION when needed, so they multiply by max_connections
# in the worst case. Keep them modest — a large sort_buffer_size is a classic way to
# turn 300 connections into an OOM.
# -----------------------------------------------------------------------------
sort_buffer_size      = 2M
join_buffer_size      = 2M
read_buffer_size      = 256K
read_rnd_buffer_size  = 512K

# -----------------------------------------------------------------------------
# Query cache — REMOVED FROM MYSQL, and this is the right outcome.
#
# The query cache was removed in MySQL 8.0. It was a global mutex that invalidated
# every cached result for a table on ANY write to that table, so on a write-heavy
# multi-tenant schema it actively reduced throughput. Do not look for a replacement
# setting; there isn't one.
#
# What replaces it here, and where to look when reads get slow:
#   1. innodb_buffer_pool_size above — a correctly sized pool is the real read cache
#   2. the application's Redis layer (app.cache.enabled) for computed read models:
#      ORG_FEATURES, SHARING_PRICES, FACILITY_TREE, ROOM_SUMMARY, PROPERTY_STATS,
#      VACANT_BEDS, TEMP_STAYS. Money dashboards are deliberately not cached.
#   3. indexes — see V23, which added the facility_party composite indexes after the
#      planner was found filtering the tenant-list hot path in memory
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Binary logging
#
# ON by default in 8.4 and left on deliberately. It is what makes point-in-time
# recovery possible: a nightly mysqldump plus the binlogs lets you restore to any
# moment, rather than losing everything since the last dump. It is also the
# prerequisite for adding a replica later.
# -----------------------------------------------------------------------------
server_id  = 1
log_bin    = /var/lib/mysql/binlog
binlog_format = ROW              # the only safe format for statement-level determinism

# Log only changed columns rather than the whole row. Meaningfully smaller binlogs on
# wide tables — api_request_log has 32 columns.
binlog_row_image = MINIMAL

# 7 days. Long enough to recover to any point since the oldest retained dump; short
# enough that binlogs cannot silently fill the boot volume.
binlog_expire_logs_seconds = 604800
max_binlog_size = 256M

# fsync the binlog at every commit. Paired with innodb_flush_log_at_trx_commit=1 this
# gives a genuinely crash-safe commit. It is the expensive choice; for financial rows
# it is the correct one.
sync_binlog = 1

# GTIDs make replica setup and failover tractable, and cost nothing now.
gtid_mode = ON
enforce_gtid_consistency = ON

# -----------------------------------------------------------------------------
# Slow query log
#
# Written to the host-mounted ./logs/mysql so it survives the container.
# -----------------------------------------------------------------------------
slow_query_log      = 1
slow_query_log_file = /var/log/mysql/slow.log

# 1 second. Any API query slower than this is a user-visible stall worth reading.
long_query_time     = 1

# Deliberately OFF. Turning it on floods the log with tiny lookups that use no index
# because the table has twelve rows and a scan is correct. min_examined_row_limit
# below is the better filter — it catches genuine missing-index scans.
log_queries_not_using_indexes = 0
min_examined_row_limit        = 1000

log_slow_admin_statements = 1

# -----------------------------------------------------------------------------
# Error log
#
# log_error is deliberately NOT set, so MySQL keeps writing to stderr and the output
# is captured by Docker — `docker compose logs mysql` works, and the 10MB x 5
# rotation configured in docker-compose.yml applies to it.
#
# Redirecting it to a file inside the container would make `docker compose logs`
# silent, which is exactly the wrong outcome: the error log is the first thing you
# reach for when the container will not start, and at that point there is no
# container left to exec into and read the file from.
#
# The slow query log below IS a file, because it is for later analysis rather than
# live diagnosis, and interleaving it with startup output would make both harder to read.
# -----------------------------------------------------------------------------
log_error_verbosity = 2          # errors + warnings; 3 adds notes and is very noisy

# -----------------------------------------------------------------------------
# SQL mode
#
# Explicitly set to the 8.4 default rather than left implicit, because the
# application depends on it. ONLY_FULL_GROUP_BY in particular shapes several queries
# in the report and occupancy modules — the room/bed and property lookups in the rent
# collection report are scalar subqueries specifically because a join would need a
# GROUP BY that this mode rejects. Removing it would not break anything today, but it
# would let a future non-deterministic GROUP BY through unnoticed.
# -----------------------------------------------------------------------------
sql_mode = ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# Reject a DELETE or UPDATE with no WHERE clause from an interactive client.
# Costs nothing; has saved many production tables.
safe-updates = 0                 # keep 0 for the app; enable per-session for humans

# -----------------------------------------------------------------------------
# Performance schema
#
# Left ON. It costs a few hundred MB and roughly 5% overhead, and it is the only way
# to answer "what is the database doing right now" during an incident. Turning it off
# to reclaim memory is a trade you regret exactly once.
# -----------------------------------------------------------------------------
performance_schema = ON

# -----------------------------------------------------------------------------
# Authentication
#
# 8.4 removed default_authentication_plugin; authentication_policy is the replacement.
# caching_sha2_password is the default and is fully supported by Connector/J 8.x
# (which Spring Boot 3.3 pulls in). The JDBC URL sets allowPublicKeyRetrieval=true so
# the initial RSA key exchange works over the unencrypted intra-container link.
# -----------------------------------------------------------------------------
authentication_policy = caching_sha2_password
