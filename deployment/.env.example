# =============================================================================
# PG Manager — production environment
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored and MUST stay that way. It is the only place secrets exist
# on the host; nothing below is baked into an image or committed.
#
# Generate every secret rather than inventing one:
#   openssl rand -base64 36 | tr -d '\n/+=' | cut -c1-32     # passwords
#   openssl rand -base64 64 | tr -d '\n'                      # JWT secret
#
# Variables marked REQUIRED have no default: docker compose refuses to start
# without them (`${VAR:?...}`), which is deliberate — a missing JWT secret must be
# a loud failure, not a silent fallback to the development one.
# =============================================================================


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# REQUIRED. Database name. Created by the container on first boot and migrated by
# Flyway; changing it afterwards points the app at an empty database.
POSTGRES_DB=pg_manager

# REQUIRED. The application's account. Unlike the previous MySQL setup there is no
# separate superuser: initdb creates exactly one role, and it owns the database.
#
# This role IS a superuser, and that is a real difference from the MySQL stack, where
# the app had a scoped GRANT and root was reserved for backups. Splitting it would
# mean a second role plus ALTER DEFAULT PRIVILEGES for every object Flyway creates,
# and Flyway needs full DDL regardless. The mitigation is the same one that made the
# MySQL grant acceptable: the container publishes no port, sits on an `internal`
# network with no route out, and nothing but the API and the backup job can reach it.
POSTGRES_USER=pgmanager

# REQUIRED. Password for POSTGRES_USER.
POSTGRES_PASSWORD=change-me-app-32-char-random

# HikariCP pool bounds. Keep DB_POOL_MAX well under PostgreSQL's max_connections (200
# in postgresql.conf): each API replica opens up to this many, and pg_dump plus the
# healthcheck need headroom too. PostgreSQL forks a backend PROCESS per connection, so
# an oversized pool costs far more here than it did on MySQL. 30 comfortably saturates
# 2 vCPUs of database.
DB_POOL_MAX=30
DB_POOL_MIN=10


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# REQUIRED. Redis has no user model here; this password is the whole auth story.
# It is on an `internal: true` network with no published port, but set it anyway —
# an unauthenticated Redis is the single most-scanned service on the internet.
REDIS_PASSWORD=change-me-redis-32-char-random

# Master switch for the cache layer. `true` in production: the app falls back to
# direct DB reads if Redis is unreachable (CacheErrorHandler is fail-open), so this
# is safe to leave on even during a Redis outage.
CACHE_ENABLED=true


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

SPRING_PROFILES_ACTIVE=prod

# REQUIRED. HS256 signing key for access tokens.
#
# Two things also depend on this value, and both break when it changes:
#   1. every issued access + refresh token is invalidated (all users signed out)
#   2. SelfCheckinTokenService signs the tenant self check-in QR links with it,
#      so every printed/shared QR code stops validating
# Rotate only with intent, and reprint the QR codes afterwards.
# Minimum 32 bytes; use `openssl rand -base64 64`.
JWT_SECRET=change-me-generate-with-openssl-rand-base64-64

# Port the JVM listens on inside the container. Not published; nginx proxies to it.
SERVER_PORT=8080

# Actuator port. Separate context on purpose — see the Dockerfile HEALTHCHECK note.
# Never publish this and never proxy it wholesale from nginx: the management context
# is outside the app's Spring Security filter chain.
MANAGEMENT_PORT=9091

# JVM tuning. Percentages, not absolute sizes, so this tracks the container's memory
# limit in docker-compose.yml instead of silently disagreeing with it.
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=70.0 -XX:InitialRAMPercentage=40.0 -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+UseStringDeduplication -XX:+ExitOnOutOfMemoryError -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs -Djava.awt.headless=true -Dfile.encoding=UTF-8 -Djava.io.tmpdir=/app/tmp

# Interactive API docs. OFF in production — the spec enumerates every endpoint and
# role for an attacker. nginx also blocks the paths (defence in depth). Flip to true
# temporarily if you need them, and remember to flip it back.
SWAGGER_ENABLED=false

# Retention for api_request_log. Every request is stored with no sampling, so this
# table is the fastest-growing thing in the database — raise it only after checking
# `SELECT COUNT(*) FROM api_request_log`.
API_LOG_ENABLED=true
API_LOG_RETENTION_DAYS=10


# -----------------------------------------------------------------------------
# Container image (set by CI; the deploy script rewrites IMAGE_TAG)
# -----------------------------------------------------------------------------

API_IMAGE=ghcr.io/your-org/pg-manager-backend

# Never `latest` in production — it makes rollback ambiguous and `docker compose pull`
# non-deterministic. CI sets this to the commit SHA.
IMAGE_TAG=latest

BUILD_COMMIT=unknown
BUILD_DATE=unknown


# -----------------------------------------------------------------------------
# Nginx / TLS
# -----------------------------------------------------------------------------

# REQUIRED. Apex or subdomain this stack serves. Substituted into the nginx config
# at container start and used as the API's APP_PUBLIC_BASE_URL origin.
DOMAIN_NAME=api.example.com

# Contact address for the Let's Encrypt account — expiry warnings go here.
EMAIL_FOR_SSL=admin@example.com

# Set to 1 while testing issuance. The staging CA has effectively no rate limit;
# the production CA allows 5 failed authorisations per hostname per hour, and it is
# easy to burn through that on a DNS misconfiguration. Set back to 0 for a real cert.
CERTBOT_STAGING=0


# -----------------------------------------------------------------------------
# Mail (optional — leave MAIL_HOST empty to disable outbound tenant email)
#
# With EMAIL_ENABLED=false the app still boots and still queues rows in
# notification_outbox; they simply stay unsent until this is configured.
# -----------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=PG Manager


# -----------------------------------------------------------------------------
# Timezone
#
# Applied to every container AND to PostgreSQL's timezone setting. The application's
# schedulers are wall-clock based — invoice generation at 01:00, bed transfers at
# 00:05, rent reminders at 09:00, api-log cleanup at 03:15 — so a mismatch between
# the app container and the database shifts billing dates by the offset.
# Change it in one place only: here.
# -----------------------------------------------------------------------------
TZ=Asia/Kolkata


# -----------------------------------------------------------------------------
# Backups (scripts/backup.sh)
# -----------------------------------------------------------------------------

# Days of local backups to keep. Local retention is not a backup strategy on its
# own — see the off-host copy note in deployment/README.md.
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=/opt/pgmanager/deployment/backups
