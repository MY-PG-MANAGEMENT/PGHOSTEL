# =============================================================================
# LOCAL DEVELOPMENT overrides for docker-compose.yml.
#
#   cp .env.example .env      # only if you want to change a default
#
# You usually do NOT need this file. Every value below already has a default in
# docker-compose.yml that matches backend/src/main/resources/application.yml, so
# `docker compose up -d` followed by `./gradlew bootRun` works with no setup.
#
# -----------------------------------------------------------------------------
# THIS FILE HAS NOTHING TO DO WITH PRODUCTION.
#
# Production is Koyeb, and its configuration lives in Koyeb's environment
# variables — not in any file in this repository. The production variable list is
# in README.md ("Deploying to Koyeb"). In particular JWT_SECRET, the database URL
# and the Redis password must never appear in a committed file:
# application-prod.yml declares them with NO default precisely so a missing one
# fails the context at startup instead of silently falling back to a development
# value.
# =============================================================================

# --- PostgreSQL (local container) --------------------------------------------
# Deliberately trivial credentials. The port is bound to 127.0.0.1 only, so this
# database is not reachable from whatever network you are on.
POSTGRES_DB=pg_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Change if 5432 is already taken by a system PostgreSQL. If you do, point the app
# at the new port too:
#   ./gradlew bootRun --args='--spring.datasource.url=jdbc:postgresql://localhost:5433/pg_manager'
POSTGRES_PORT=5432

# --- Redis (local container) --------------------------------------------------
# No password locally; application.yml's REDIS_PASSWORD default is empty.
REDIS_PORT=6379

# --- Timezone -----------------------------------------------------------------
# The schedulers are wall-clock based (invoices 01:00, bed transfers 00:05, rent
# reminders 09:00, api-log cleanup 03:15) and created_at is a `timestamp without
# time zone` written from the JVM, so keep the container and your JVM in the same
# zone or generated due dates shift by the offset.
TZ=Asia/Kolkata

# --- Containerised API (only with `--profile app`) ---------------------------
# Left as `default` on purpose: the prod profile requires JWT_SECRET and
# APP_PUBLIC_BASE_URL with no fallback and would refuse to start.
SPRING_PROFILES_ACTIVE=default
